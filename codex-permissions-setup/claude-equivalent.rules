# Explicit command blocks adapted from Claude permissions.
# Prefix rules are not a filesystem security boundary or shell-glob matcher.
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["apt-get"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["apt"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["shutdown"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["reboot"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["pip", "install"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["pip3", "install"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["conda", "install"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["mamba", "install"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["conda", "create"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["mamba", "create"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["python", "-m", "pip", "install"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["python3", "-m", "pip", "install"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["rm", "-rf", "/"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["rm", "-rf", "~"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["rm", "-rf", "~/*"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["rm", "-rf", "/home/ghaedi"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["rm", "-rf", "/home/ghaedi/"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
prefix_rule(pattern = ["rm", "-rf", "/home/ghaedi/*"], decision = "forbidden", justification = "Preserved project restriction from Claude settings.")
